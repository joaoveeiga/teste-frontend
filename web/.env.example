# Copy to .env.local (not committed).
# App running outside Docker (compose "dev" profile): http://127.0.0.1:4010
# App running inside the compose network: http://mock-api:4010
MOCK_API_URL=http://127.0.0.1:4010
# Same value as MOCK_API_KEY in the kit's .env (used by src/lib/api.ts).
NEXT_PUBLIC_MOCK_API_KEY=troque-por-uma-chave-local
